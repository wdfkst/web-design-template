    "@vudt/codegen": "workspace:*",
    "@vudt/imagegen": "workspace:*",
    "@vudt/providers": "workspace:*",
    "@vudt/spec": "workspace:*",
    "archiver": "7.0.1",
    "fastify": "5.6.1"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/node": "^22.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
