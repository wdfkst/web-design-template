{
  "name": "vue-ui-design-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:admin-previews",
    "test:admin-previews": "vitest run scripts/admin-style-previews/__tests__/preview.test.ts",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/admin-style-previews/tsconfig.json",
    "build:admin-previews": "tsx scripts/admin-style-previews/build.ts build",
    "check:admin-previews": "tsx scripts/admin-style-previews/build.ts check"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
